package DbxOpenOdbcDataExplorer;

{$R *.res}
// Keep LIBSUFFIX in sync with Project > Options > Description > LIB suffix.
// See README.md for the Delphi package-version table.
{$RANGECHECKS OFF}
{$LIBSUFFIX '280'}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  dbrtl,
  dbexpress;

contains
  OdbcApi in '..\..\source\OdbcApi.pas',
  DbxOpenOdbcCore in '..\..\source\DbxOpenOdbcCore.pas',
  DbxOpenOdbcDriver in '..\..\source\DbxOpenOdbcDriver.pas',
  DbxOpenOdbcDataExplorerMetadata in 'DbxOpenOdbcDataExplorerMetadata.pas';

end.
